# Copy this file to the repository root as .env for an editable checkout,
# or set PANDA_ENV_FILE=/absolute/path/to/your.env for an installed wheel.
# Never commit a populated environment file.

# Gemini text provider for planning and reflection.
PLANNER_PROVIDER=gemini
REFLECTION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Alternative local/OpenAI-compatible text providers. EMPTY is accepted only
# for localhost/loopback URLs. Reflection fields may be omitted to inherit the
# planner's OpenAI-compatible settings.
# PLANNER_PROVIDER=openai
# PLANNER_BASE_URL=http://127.0.0.1:8000/v1
# PLANNER_API_KEY=EMPTY
# PLANNER_MODEL=/path/to/local-model
# REFLECTION_PROVIDER=openai
# REFLECTION_BASE_URL=http://127.0.0.1:8000/v1
# REFLECTION_API_KEY=EMPTY
# REFLECTION_MODEL=/path/to/local-model

# OpenAI-compatible multimodal VLM endpoint registry.
VLM_ENDPOINTS='{"qwen2_5_7b_v0":{"base_url":"http://127.0.0.1:8000/v1","api_key":"EMPTY","model":"/path/to/Qwen2.5-VL-7B-Instruct"}}'
VLM_MODEL_PATH=/path/to/Qwen2.5-VL-7B-Instruct
# Required by the paper-profile scripts. The manifest must list every deployed
# model file with its size and SHA-256; the aggregate is verified before launch.
VLM_MODEL_MANIFEST=/path/to/qwen-content-manifest.json
VLM_MODEL_SHA256=

# Dataset-specific RAG rules; FAISS also requires an index and embedding model.
PANDA_RULES_DIR=/path/to/dataset-specific-rules
EMBEDDING_MODEL_PATH=/path/to/all-MiniLM-L6-v2
EMBEDDING_MODEL_MANIFEST=/path/to/minilm-content-manifest.json
EMBEDDING_MODEL_SHA256=

# Local reflection-tool model paths.
PANDA_YOLO_MODEL_PATH=/path/to/yolov8l-worldv2.pt
PANDA_CLIP_MODEL_PATH=/path/to/clip-vit-base-patch32
PANDA_SR_MODEL_PATH=/path/to/RealESRGAN_x4plus.pth
# Paper profiles require verified content identities for all three tools.
# YOLO/SR: file SHA-256; CLIP: build_content_manifest.py aggregate.
PANDA_YOLO_MODEL_SHA256=
PANDA_SR_MODEL_SHA256=
PANDA_CLIP_MODEL_SHA256=

# Optional Tavily-backed web-search reflection tool.
TAVILY_API_KEY=
